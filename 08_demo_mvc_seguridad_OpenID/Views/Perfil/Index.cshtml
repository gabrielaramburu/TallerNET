@model _08_demo_mvc_seguridad_OpenID.ViewModels.Perfil.PerfilUsuarioViewModel

@{
    ViewData["Title"] = "Perfil e Inspección de Claims";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h1 class="display-6 fw-bold text-primary">
            <i class="bi bi-person-badge-fill me-2"></i>Perfil del Usuario y Claims OpenID
        </h1>
        <p class="text-muted lead mb-0">
            Inspección en tiempo real de los datos de identidad provistos por el ID Token de OpenID Connect.
        </p>
    </div>
</div>

@if (!Model.EstaAutenticado)
{
    <div class="card shadow-sm border-0 p-5 text-center bg-white">
        <div class="card-body">
            <i class="bi bi-person-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 fw-bold">Usuario No Autenticado</h4>
            <p class="text-muted col-md-8 mx-auto">
                Para visualizar los Claims (afirmaciones de identidad emitidas por el Proveedor OpenID), primero debes iniciar sesión.
            </p>
            <a asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Perfil")" class="btn btn-primary mt-2">
                <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesión
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-4">
                @if (!string.IsNullOrEmpty(Model.FotoUrl))
                {
                    <img src="@Model.FotoUrl" alt="Avatar" class="rounded-circle border shadow-sm" width="80" height="80" />
                }
                else
                {
                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-person-fill fs-1"></i>
                    </div>
                }
                <div>
                    <h3 class="fw-bold mb-1">@Model.Nombre</h3>
                    <p class="text-muted mb-1"><i class="bi bi-envelope me-1"></i>@Model.Email</p>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="bi bi-check-circle me-1"></i>Autenticado mediante OpenID Connect
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h4 class="fw-bold text-dark mb-1"><i class="bi bi-list-check me-2"></i>Claims Recibidos en HttpContext.User</h4>
            <p class="text-muted small mb-0">
                Cada fila representa una afirmación de identidad (Claim) emitida y firmada criptográficamente por el Proveedor de Identidad.
            </p>
        </div>
        <div class="card-body px-4 pb-4">
            <partial name="_TablaClaimsPartial" model="Model.Claims" />
        </div>
    </div>
}
