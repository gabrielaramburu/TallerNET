@using System.Security.Claims

<ul class="navbar-nav align-items-center">
@if (User.Identity?.IsAuthenticated == true)
{
    var nombreUsuario = User.FindFirst("name")?.Value 
                        ?? User.FindFirst(ClaimTypes.Name)?.Value 
                        ?? User.FindFirst("nickname")?.Value 
                        ?? User.Identity.Name 
                        ?? "Usuario";
                        
    var avatarUrl = User.FindFirst("picture")?.Value;
    var email = User.FindFirst(ClaimTypes.Email)?.Value 
                ?? User.FindFirst("email")?.Value;

    var esDocente = User.IsInRole("Docente") || User.IsInRole("Admin");
    var esEstudiante = User.IsInRole("Estudiante") || !esDocente;

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="navbarUserDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            @if (!string.IsNullOrEmpty(avatarUrl))
            {
                <img src="@avatarUrl" alt="Avatar" class="rounded-circle border" width="28" height="28" />
            }
            else
            {
                <i class="bi bi-person-circle fs-5 text-light"></i>
            }
            <span class="fw-semibold text-white">@nombreUsuario</span>
            
            @if (esDocente)
            {
                <span class="badge bg-warning text-dark px-2 py-1 small">Docente</span>
            }
            else
            {
                <span class="badge bg-primary px-2 py-1 small">Estudiante</span>
            }
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="navbarUserDropdown">
            <li class="px-3 py-2 text-muted small border-bottom">
                <i class="bi bi-envelope me-1"></i>@(email ?? "Sin email")
            </li>
            
            @if (esDocente)
            {
                <li>
                    <a class="dropdown-item py-2 text-warning-emphasis fw-semibold" asp-controller="Cursos" asp-action="Crear">
                        <i class="bi bi-plus-circle me-2 text-warning"></i>Crear Nuevo Curso
                    </a>
                </li>
            }
            else
            {
                <li>
                    <a class="dropdown-item py-2" asp-controller="Cursos" asp-action="MisCursos">
                        <i class="bi bi-mortarboard me-2 text-primary"></i>Mis Cursos Inscritos
                    </a>
                </li>
            }

            <li>
                <a class="dropdown-item py-2" asp-controller="Perfil" asp-action="Index">
                    <i class="bi bi-person-badge me-2 text-primary"></i>Mi Perfil & Claims OIDC
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item py-2 text-danger" asp-controller="Cuenta" asp-action="Logout">
                    <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión (OpenID)
                </a>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-primary btn-sm px-3" asp-controller="Cuenta" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesión
        </a>
    </li>
}
</ul>
