@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-6 text-center">
        <div class="card shadow-sm border-0 p-5">
            <i class="bi bi-shield-x text-danger" style="font-size: 4.5rem;"></i>
            <h2 class="mt-3 fw-bold text-danger">Acceso Denegado</h2>
            <p class="text-muted lead">
                Tu usuario autenticado mediante OpenID Connect no dispone del rol necesario (<strong>Docente / Admin</strong>) para ejecutar esta acción.
            </p>
            <div class="alert alert-warning text-start small border-start border-warning border-4">
                <h6 class="fw-bold"><i class="bi bi-info-circle me-1"></i>Explicación Didáctica (RBAC):</h6>
                <p class="mb-0">
                    La ruta que intentaste acceder está protegida con el atributo <code>[Authorize(Roles = "Docente,Admin")]</code>. Como tu ID Token no contiene este rol en el Claim de autorización, el middleware de ASP.NET Core deniega el acceso automáticamente.
                </p>
            </div>
            <div class="d-flex justify-content-center gap-2 mt-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-house-door me-1"></i>Ir al Inicio
                </a>
                <a asp-controller="Perfil" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-person-badge me-1"></i>Ver mis Claims y Roles
                </a>
            </div>
        </div>
    </div>
</div>
