@model IEnumerable<_08_demo_mvc_seguridad_OpenID.ViewModels.Cursos.TarjetaCursoViewModel>

@{
    ViewData["Title"] = "Mis Cursos Inscritos";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h1 class="display-6 fw-bold text-primary">
            <i class="bi bi-mortarboard-fill me-2"></i>Mis Cursos Inscritos
        </h1>
        <p class="text-muted lead mb-0">
            Listado de cursos asociados a tu cuenta de Estudiante identificada mediante OpenID Connect.
        </p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <!-- Acción Visitante/Explorar: Gris -->
        <a asp-controller="Cursos" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-journal-bookmark me-1"></i>Ver Catálogo Completo
        </a>
    </div>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card text-center p-5 border-0 shadow-sm bg-light">
        <div class="card-body">
            <i class="bi bi-journal-x text-muted" style="font-size: 3.5rem;"></i>
            <h4 class="mt-3 fw-bold">Aún no te has inscrito a ningún curso</h4>
            <p class="text-muted">Explora el catálogo y elige los cursos que deseas cursar.</p>
            <a asp-controller="Cursos" asp-action="Index" class="btn btn-secondary mt-2">
                <i class="bi bi-search me-1"></i>Ir al Catálogo de Cursos
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_TarjetaCursoPartial" model="item" />
            </div>
        }
    </div>
}
