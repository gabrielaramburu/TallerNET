@model IEnumerable<_08_demo_mvc_seguridad_OpenID.ViewModels.Cursos.TarjetaCursoViewModel>

@{
    var esDocente = (ViewData["EsDocente"] as bool?) == true;
    ViewData["Title"] = esDocente ? "Mis Cursos Publicados (Docente)" : "Catálogo de Cursos";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-7">
        <h1 class="display-6 fw-bold text-dark">
            @if (esDocente)
            {
                <i class="bi bi-person-workspace text-warning me-2"></i><span>Mis Cursos Publicados</span>
            }
            else
            {
                <i class="bi bi-journal-bookmark-fill me-2"></i><span>Catálogo de Cursos</span>
            }
        </h1>
        <p class="text-muted lead mb-0">
            @if (esDocente)
            {
                <span>Gestión y administración de los cursos a tu cargo en la plataforma.</span>
            }
            else
            {
                <span>Explora la oferta formativa disponible en la plataforma.</span>
            }
        </p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end gap-2">
        <!-- Acción Docente: Amarillo -->
        @if (esDocente)
        {
            <a asp-action="Crear" class="btn btn-warning text-dark">
                <i class="bi bi-plus-circle me-1"></i>Crear Nuevo Curso
            </a>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <!-- Acción Estudiante: Azul -->
            <a asp-controller="Cursos" asp-action="MisCursos" class="btn btn-primary">
                <i class="bi bi-mortarboard me-1"></i>Mis Cursos
            </a>
        }
    </div>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card text-center p-5 border-0 shadow-sm bg-light">
        <div class="card-body">
            <i class="bi bi-journal-plus text-warning" style="font-size: 3.5rem;"></i>
            <h4 class="mt-3 fw-bold">Aún no tienes cursos publicados</h4>
            <p class="text-muted">Como docente, puedes crear y publicar nuevos cursos para que los estudiantes se inscriban.</p>
            <a asp-action="Crear" class="btn btn-warning text-dark mt-2">
                <i class="bi bi-plus-circle me-1"></i>Crear Mi Primer Curso
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <!-- Uso de Vista Parcial modular -->
                <partial name="_TarjetaCursoPartial" model="item" />
            </div>
        }
    </div>
}
